<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NitroPower.Gui.ViewModels"
             xmlns:c="using:NitroPower.Gui.Controls"
             xmlns:l="using:NitroPower.Gui.Localization"
             x:Class="NitroPower.Gui.Views.PerformanceView"
             x:DataType="vm:PerformanceViewModel">
  <StackPanel Spacing="16">

    <!-- Modes -->
    <Border Classes="card">
      <StackPanel Spacing="14">
        <StackPanel Spacing="2">
          <TextBlock Classes="h2" Text="{l:Tr perf.modes}" />
          <TextBlock Classes="caption" Text="{l:Tr perf.modes.desc}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Modes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="4" ColumnSpacing="12" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ModeItem">
              <Button Classes="tile" Classes.on="{Binding IsCurrent}" Command="{Binding SelectCommand}"
                      IsEnabled="{Binding IsAvailable}" MinHeight="150">
                <DockPanel>
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                    <Border Classes="bubble" Background="{Binding SoftBrush}">
                      <c:Icon Data="{Binding Icon}" Foreground="{Binding Brush}" Width="19" Height="19" />
                    </Border>
                    <Border Grid.Column="2" Width="20" Height="20" CornerRadius="10" Background="{Binding Brush}"
                            IsVisible="{Binding IsCurrent}" VerticalAlignment="Top">
                      <c:Icon Data="{DynamicResource ico.check}" Foreground="#0B0F17" Width="13" Height="13" StrokeThickness="3" />
                    </Border>
                  </Grid>
                  <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" Classes="h2" />
                  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Note}" FontSize="11.5" FontWeight="Medium"
                             Foreground="{Binding Brush}" Margin="0,10,0,0" />
                  <TextBlock Text="{Binding Description}" Classes="caption" Margin="0,4,0,0" />
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
      <!-- Turbo -->
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="bubble" Background="#26F43F5E">
              <c:Icon Data="{DynamicResource ico.flame}" Foreground="#F43F5E" Width="19" Height="19" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="h2" Text="Turbo" />
              <TextBlock Classes="caption" Text="{Binding TurboState}" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Classes="wrap" Text="{Binding TurboSummary}" />
            <TextBlock Classes="caption" Text="{Binding TurboHint}" />
          </StackPanel>
          <Button Grid.Row="2" Classes="turbo" Classes.on="{Binding IsTurbo}" Command="{Binding ToggleTurboCommand}"
                  IsEnabled="{Binding CanTurbo}" HorizontalContentAlignment="Center" Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Data="{DynamicResource ico.flame}" Foreground="#F43F5E" />
              <TextBlock FontWeight="SemiBold" Text="{Binding TurboAction}" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Mode key cycle -->
      <Border Grid.Column="1" Classes="card">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="bubble">
              <c:Icon Data="{DynamicResource ico.cycle}" Width="19" Height="19" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Classes="h2" Text="{l:Tr cycle.title}" />
              <TextBlock Classes="caption" Text="{l:Tr cycle.desc}" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="8">
            <Grid ColumnDefinitions="110,*">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{DynamicResource ico.plug}" Width="15" Height="15" Foreground="{DynamicResource Np.TextDim}" />
                <TextBlock Classes="dim" Text="{l:Tr power.ac}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding CycleAc}" FontWeight="Medium" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="110,*">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{DynamicResource ico.battery}" Width="15" Height="15" Foreground="{DynamicResource Np.TextDim}" />
                <TextBlock Classes="dim" Text="{l:Tr power.battery}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding CycleBattery}" FontWeight="Medium" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Classes="caption" Text="{Binding CycleFans}" />
          </StackPanel>
          <Button Grid.Row="2" Classes="ghost" Command="{Binding NextModeCommand}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Data="{DynamicResource ico.cycle}" />
              <TextBlock FontWeight="SemiBold" Text="{l:Tr cycle.next}" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- GPU overclock -->
    <Border Classes="card" IsVisible="{Binding HasGpu}">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="bubble" Background="#26A3E635">
            <c:Icon Data="{DynamicResource ico.chip}" Foreground="#A3E635" Width="19" Height="19" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Classes="h2" Text="{l:Tr gpu.title}" />
            <TextBlock Classes="caption" Text="{Binding GpuName}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="2" IsChecked="{Binding OverclockEnabled}" IsEnabled="{Binding HasOverclock}" />
        </Grid>

        <TextBlock Classes="caption" Text="{l:Tr gpu.noLevels}" IsVisible="{Binding !HasOverclock}" />

        <UniformGrid Columns="3" ColumnSpacing="12" IsVisible="{Binding HasOverclock}">
          <Border Classes="inset">
            <StackPanel Spacing="3">
              <TextBlock Classes="label" Text="{l:Tr gpu.now}" />
              <TextBlock Classes="value" Text="{Binding OffsetsNow}" />
            </StackPanel>
          </Border>
          <Border Classes="inset">
            <StackPanel Spacing="3">
              <TextBlock Classes="label" Text="{l:Tr gpu.wanted}" />
              <TextBlock Classes="value" Text="{Binding OffsetsWanted}" />
            </StackPanel>
          </Border>
          <Border Classes="inset">
            <StackPanel Spacing="3">
              <TextBlock Classes="label" Text="{l:Tr gpu.policy}" />
              <TextBlock Classes="caption" Text="{Binding PolicyText}" Foreground="{DynamicResource Np.Text}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <StackPanel Spacing="8" IsVisible="{Binding HasOverclock}">
          <StackPanel Spacing="2" Margin="0,4,0,0">
            <TextBlock Classes="h3" Text="{l:Tr gpu.levels}" />
            <TextBlock Classes="caption" Text="{l:Tr gpu.levels.desc}" />
          </StackPanel>
          <Grid ColumnDefinitions="70,*,170,170,120" Margin="12,4,12,0">
            <TextBlock Classes="label" Text="{l:Tr gpu.levels.level}" />
            <TextBlock Grid.Column="1" Classes="label" Text="{l:Tr gpu.levels.modes}" />
            <TextBlock Grid.Column="2" Classes="label" Text="{l:Tr gpu.levels.core}" />
            <TextBlock Grid.Column="3" Classes="label" Text="{l:Tr gpu.levels.mem}" />
            <TextBlock Grid.Column="4" Classes="label" Text="{l:Tr gpu.levels.profile}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Levels}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GpuLevelRow">
                <Border Classes="inset" Padding="12,6">
                  <Grid ColumnDefinitions="70,*,170,170,120">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                      <Run Text="N" /><Run Text="{Binding Index}" />
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Modes}" VerticalAlignment="Center" Classes="dim" TextTrimming="CharacterEllipsis" />
                    <NumericUpDown Grid.Column="2" Value="{Binding Core}" Minimum="{x:Static vm:GpuLevelRow.CoreMin}" Maximum="{x:Static vm:GpuLevelRow.CoreMax}" Increment="5"
                                   FormatString="+0;-0;0" Margin="0,0,12,0" />
                    <NumericUpDown Grid.Column="3" Value="{Binding Mem}" Minimum="{x:Static vm:GpuLevelRow.MemMin}" Maximum="{x:Static vm:GpuLevelRow.MemMax}" Increment="25"
                                   FormatString="+0;-0;0" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ProfileText}" Classes="dim" />
                      <Ellipse Width="7" Height="7" Fill="{DynamicResource Np.Warning}" IsVisible="{Binding IsChanged}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="caption" Text="{l:Tr gpu.levels.warning}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Classes="primary" Command="{Binding ApplyLevelsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icon Data="{DynamicResource ico.save}" Width="16" Height="16" />
                <TextBlock Text="{l:Tr gpu.levels.apply}" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" Command="{Binding UndoLevelsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icon Data="{DynamicResource ico.undo}" Width="16" Height="16" />
                <TextBlock Text="{l:Tr common.undo}" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" Command="{Binding ResetLevelsCommand}" IsEnabled="{Binding CustomLevels}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icon Data="{DynamicResource ico.refresh}" Width="16" Height="16" />
                <TextBlock Text="{l:Tr gpu.levels.reset}" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" Command="{Binding ApplyNowCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icon Data="{DynamicResource ico.play}" Width="16" Height="16" />
                <TextBlock Text="{l:Tr gpu.applyNow}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
