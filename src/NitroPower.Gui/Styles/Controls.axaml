<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:NitroPower.Gui.Controls"
        xmlns:vm="using:NitroPower.Gui.ViewModels">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Np.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource Np.Text}" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.dim, SelectableTextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource Np.TextDim}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource Np.TextFaint}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Np.TextDim}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource Np.TextFaint}" />
  </Style>
  <Style Selector="TextBlock.big">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.wrap">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource Np.Danger}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource Np.Warning}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource Np.Accent}" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Np.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Np.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource Np.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Np.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{DynamicResource Np.AccentSoft}" />
  </Style>
  <Style Selector="Border.bubble">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource Np.AccentSoft}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Np.Accent}" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="{DynamicResource Np.WarningSoft}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Np.Text}" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Np.Border}" />
    <Setter Property="Margin" Value="0,12" />
  </Style>

  <!-- Navigation -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Np.TextDim}" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Np.CardHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Np.Text}" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Np.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Np.Accent}" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Np.AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Np.Accent}" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Np.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Np.AccentText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Np.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Np.AccentText}" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Np.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Np.AccentText}" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Np.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="Foreground" Value="{DynamicResource Np.Text}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Np.CardHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Np.TextFaint}" />
    <Setter Property="Foreground" Value="{DynamicResource Np.Text}" />
  </Style>
  <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Np.Border}" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Np.DangerSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Np.Danger}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Np.Danger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource Np.TextDim}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Np.CardHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Np.Text}" />
  </Style>

  <!-- Segmented choice: a row of buttons inside Border.segbar; .on marks the chosen one -->
  <Style Selector="Border.segbar">
    <Setter Property="Background" Value="{DynamicResource Np.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Np.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.seg">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Np.TextDim}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="UniformGrid.compact > Button.seg">
    <Setter Property="Padding" Value="4,7" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Np.CardHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Np.Text}" />
  </Style>
  <Style Selector="Button.seg.on">
    <Setter Property="Background" Value="{DynamicResource Np.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Np.AccentText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.seg.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Np.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Np.AccentText}" />
  </Style>

  <!-- Selectable cards (modes, Nitro key actions); .on marks the current one -->
  <Style Selector="Button.tile">
    <Setter Property="Background" Value="{DynamicResource Np.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Np.Border}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Foreground" Value="{DynamicResource Np.Text}" />
  </Style>
  <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Np.CardHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Np.TextFaint}" />
    <Setter Property="Foreground" Value="{DynamicResource Np.Text}" />
  </Style>
  <Style Selector="Button.tile:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Np.Card}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="Button.tile.on" x:DataType="vm:ModeItem">
    <Setter Property="BorderBrush" Value="{Binding Brush}" />
    <Setter Property="Background" Value="{Binding SoftBrush}" />
  </Style>
  <Style Selector="Button.tile.on:pointerover /template/ ContentPresenter#PART_ContentPresenter" x:DataType="vm:ModeItem">
    <Setter Property="BorderBrush" Value="{Binding Brush}" />
    <Setter Property="Background" Value="{Binding SoftBrush}" />
  </Style>
  <Style Selector="Button.choice.on">
    <Setter Property="BorderBrush" Value="{DynamicResource Np.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Np.AccentSoft}" />
  </Style>
  <Style Selector="Button.choice.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Np.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Np.AccentSoft}" />
  </Style>

  <!-- Turbo button -->
  <Style Selector="Button.turbo">
    <Setter Property="Background" Value="{DynamicResource Np.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Np.Border}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.turbo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="#F43F5E" />
    <Setter Property="Background" Value="{DynamicResource Np.CardHover}" />
  </Style>
  <Style Selector="Button.turbo.on">
    <Setter Property="Background" Value="#33F43F5E" />
    <Setter Property="BorderBrush" Value="#F43F5E" />
  </Style>
  <Style Selector="Button.turbo.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#40F43F5E" />
    <Setter Property="BorderBrush" Value="#F43F5E" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <Style Selector="c|HistoryChart">
    <Setter Property="GridBrush" Value="{DynamicResource Np.Grid}" />
    <Setter Property="LabelBrush" Value="{DynamicResource Np.TextFaint}" />
  </Style>
  <Style Selector="c|FanCurveEditor">
    <Setter Property="GridBrush" Value="{DynamicResource Np.Grid}" />
    <Setter Property="LabelBrush" Value="{DynamicResource Np.TextDim}" />
    <Setter Property="SurfaceBrush" Value="{DynamicResource Np.Surface}" />
  </Style>
  <Style Selector="c|ArcGauge">
    <Setter Property="TrackBrush" Value="{DynamicResource Np.Track}" />
    <Setter Property="HotBrush" Value="{DynamicResource Np.Danger}" />
  </Style>
</Styles>
